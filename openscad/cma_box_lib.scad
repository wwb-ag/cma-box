// ============================================================================
// CMA - The Box : shared geometry library
// https://github.com/wwb-ag/cma-box
//
// ALL geometry of the convertible gauge box and its insert lives here.
// The per-division entry files (duty_division.scad,
// duty_division_insert.scad, sport_division.scad,
// sport_division_insert.scad) only set the parameters and pick the
// label set, then call cma_box() / cma_box_insert(). Adding a division
// means: four label SVGs (see assets/font/create_label_svgs.py), two
// thin entry files, one build.sh line.
//
// THE CONVERTIBLE BOX (one part, two divisions)
//   The cavity is an L: a base inner_l x inner_h x inner_w plus a fixed
//   extra pocket (inner_l/2) x opt_h x inner_w in the TOP RIGHT corner
//   of the plan view (30 mm = optic height delta). With the INSERT
//   seated, the opening reads the plain division; insert removed, the
//   L-shaped optics division. The OUTER shape is a regular rectangle:
//   the area left of the pocket is solid fill - a flat plaque flush
//   with the rim, carrying the CMA logo (inverted relief).
//
// PRINT CLEARANCE: +0.40 mm (one 0.4 mm nozzle width) is added to
// every NOMINAL inner dimension (printed cavities run up to a nozzle
// width undersized), so the printed cavity ends up at least the
// nominal size; print error should be in range +0.00 to +0.80 < 1 mm.
// The LABELS still state the nominal values.
//
// INSERT FIT: the insert's plan is 0.4 mm (= fit) smaller per axis
// than the pocket for drop-in clearance; its depth is the NOMINAL
// inner_w, NOT inner_w + fit - the printed pocket depth comes out
// ~0.4 short (the floor prints a nozzle width thick), so the nominal
// depth sits flush with the rim while the clearanced one stood proud.
//
// WALLS: wall = 3.2 mm = 8 perimeter lines at a 0.4 mm nozzle.
//
// ROUNDED EDGES: TRUE round fillets on the top rim edges - outer rim
// radius outer_r (1.0 mm), inner rim radius inner_r (double the
// outer; clamped so outer + inner <= wall), applied to every opening
// edge (incl. the pocket and shelf edges) and around the outer top
// perimeter. CONVEX VERTICAL CORNERS are rounded with corner_r (full
// wall height): sharp convex corners deposit extra material when
// printing and bulge slightly - box = the 4 OUTER + the 1 INNER
// corner where the plaque meets the pocket (the L's convex material
// corner); insert = its 4 outer corners. Concave corners stay sharp -
// only the convex side rounds.
//
// ORIENTATION NOTE - spec dims are the firearm's natural orientation
// (length x height seen from the side, width = thickness). The box
// lies flat on the bench: LENGTH x HEIGHT is the footprint, WIDTH is
// vertical. Built in print orientation: X = Length, Y = Height,
// Z = Width (walls up from the floor).
//
// LABELS (self-describing gauge): deterministic SVG outlines, never
// text(). The Rubik label lines live in assets/font/label_svgs/
// (generated by assets/font/create_label_svgs.py, which also writes
// label_data.scad - the single source for each line's advance width
// and height; do not hand-copy those numbers anywhere). Every SVG is
// normalized to CAP HEIGHT = 100 units; OpenSCAD's viewBox import maps
// 1 unit -> 0.352778 mm, so the cap imports as 35.2778 mm and scaling
// by size/35.2778 sets the cap height to 'size' mm. The import
// includes the y-flip (reads correctly from above) - do NOT mirror it.
// The logo import (assets/logo/cma_logo.svg, traced from
// CMA-logo.avif with a padded canvas) uses the same mm-per-unit
// scale; see logo_module() for the inverted-relief trick.
// ============================================================================

/* [Hidden] */
include <../assets/font/label_svgs/label_data.scad>

// OpenSCAD SVG import scale: 1 SVG unit = 0.75 pt = 0.352778 mm
SVG_MM = 0.352778;
// cap height (100 normalized units) at 1:1 import, mm
CAP_IMPORT_MM = 35.2778;
// the CMA logo SVG (see logo_module)
LOGO_SVG = "../assets/logo/cma_logo.svg";

// Look up a label row [name, text, advance, height] from label_data.scad
function label_entry(name) = [for (e = LABEL_DATA) if (e[0] == name) e][0];

// ---- Brand-font label line as SVG ------------------------------------------
// One text line, cap height = size mm, centered on the origin. The
// advance/height come from label_data.scad (generated).
module label_svg(name, size, depth) {
  e = label_entry(name);
  f = size / CAP_IMPORT_MM;
  translate([-e[2] * SVG_MM * f / 2, -e[3] * SVG_MM * f / 2, 0])
    scale([f, f, 1])
      linear_extrude(depth + 0.1)
        import(str("../assets/font/label_svgs/", name, ".svg"), center = false);
}

// ---- Box: outer shell (regular rectangle, floor at Z = 0) ------------------
module outer_shell(outer_l, outer_hb, outer_ht, outer_w) {
  translate([-outer_l / 2, -outer_hb / 2, 0])
    cube([outer_l, outer_ht, outer_w]);
}

// ---- Box: outer rim fillet cutter (top perimeter, radius r) ----------------
// Rounds the four horizontal edges where the outer wall faces meet the
// top face. Per edge: R = intersection(the two outer half-slabs) MINUS
// the fillet cylinder (axis along the edge, radius r, centered at
// (face - r, top - r)); subtract R.
module outer_fillet_cutter(outer_l, outer_hb, outer_ht, outer_w, r) {
  L = 400;
  nf = 64;
  // arc center z
  ez = outer_w - r;
  // arc center x (right/left)
  ex = outer_l / 2 - r;
  // arc center y (top edge)
  ey = -outer_hb / 2 + outer_ht - r;
  // arc center y (bottom edge)
  eyb = -outer_hb / 2 + r;
  // +x and -x top edges
  for (s = [1, -1]) {
    difference() {
      intersection() {
        translate([s == 1 ? ex : -outer_l / 2, -L, ez])
          cube([s == 1 ? L : r, 2 * L, r + 1]);
        translate([-L, -L, ez])
          cube([2 * L, 2 * L, r + 1]);
      }
      translate([s * ex, 0, ez])
        rotate([90, 0, 0])
          cylinder(r = r, h = 2 * L, center = true, $fn = nf);
    }
  }
  // +y and -y top edges (the inward slab width is r, outward is r+1)
  for (s = [1, -1]) {
    difference() {
      intersection() {
        translate([-L, s == 1 ? ey : eyb - r, ez])
          cube([2 * L, s == 1 ? r + 1 : r, r + 1]);
        translate([-L, -L, ez])
          cube([2 * L, 2 * L, r + 1]);
      }
      translate([0, s == 1 ? ey : eyb, ez])
        rotate([0, 90, 0])
          cylinder(r = r, h = 2 * L, center = true, $fn = nf);
    }
  }
}

// ---- Box: cavity (L-prism, open top) ----------------------------------------
// Base inner_l x inner_h plus the optic pocket (half length, opt_h tall)
// in the TOP RIGHT of the plan view.
module cavity(il, ih, iw, opt_h, pocket_l, wall) {
  union() {
    // base
    translate([-il / 2, -ih / 2, wall])
      cube([il, ih, iw]);
    // optic pocket, top-right
    translate([0, ih / 2, wall])
      cube([pocket_l, opt_h, iw]);
  }
}

// ---- Box: inner rim fillet cutters (quarter-circle, radius r) ---------------
// The rounded opening is "the L cavity grown by the fillet profile"
// g(z) = r - sqrt(r^2 - (z - (outer_w - r))^2) at each height (g = 0 at
// z = outer_w - r, g = r at z = outer_w). Cross-sections stay
// rectilinear and the corners miter as curved corner edges: each "grown
// slab" is a box (bounds grown by r, z in [outer_w - r, outer_w]) MINUS
// its two edge cylinders (axis along the slab direction, radius r,
// centered at grown-bounds minus r, z = outer_w - r). The grown L is
// (base slab_x intersect slab_y) union (pocket slab_x intersect
// slab_y), subtracted from the shell.
module slab_x(x_lo, x_hi, r, outer_w) {
  z0 = outer_w - r;
  L = 400;
  nf = 64;
  difference() {
    translate([x_lo - r, -L, z0])
      cube([x_hi - x_lo + 2 * r, 2 * L, r]);
    translate([x_lo - r, 0, z0])
      rotate([90, 0, 0])
        cylinder(r = r, h = 2 * L, center = true, $fn = nf);
    translate([x_hi + r, 0, z0])
      rotate([90, 0, 0])
        cylinder(r = r, h = 2 * L, center = true, $fn = nf);
  }
}
module slab_y(y_lo, y_hi, r, outer_w) {
  z0 = outer_w - r;
  L = 400;
  nf = 64;
  difference() {
    translate([-L, y_lo - r, z0])
      cube([2 * L, y_hi - y_lo + 2 * r, r]);
    translate([0, y_lo - r, z0])
      rotate([0, 90, 0])
        cylinder(r = r, h = 2 * L, center = true, $fn = nf);
    translate([0, y_hi + r, z0])
      rotate([0, 90, 0])
        cylinder(r = r, h = 2 * L, center = true, $fn = nf);
  }
}
module fillet_cutter(il, ih, opt_h, pocket_l, outer_w, r) {
  intersection() {
    slab_x(-il / 2, il / 2, r, outer_w);
    slab_y(-ih / 2, ih / 2, r, outer_w);
  }
  intersection() {
    slab_x(0, pocket_l, r, outer_w);
    slab_y(ih / 2, ih / 2 + opt_h, r, outer_w);
  }
}

// ---- Box: convex vertical corner rounding -----------------------------------
// TRUE tangent round on each CONVEX vertical corner: cutter = corner
// block (r x r on the material side, full height) MINUS a cylinder of
// radius r centered INSIDE the material at (r, r) from the corner. That
// leaves a smooth quarter-cylinder that is tangent to both faces - NOT
// the cuspy "quarter circle" you get from a cylinder centered on the
// corner vertex. Convex corners: the 4 OUTER + the L's INNER corner at
// (0, ih/2). The inner corner cutter starts at the FLOOR TOP (wall), so
// it never cuts through the pocket floor. Concave cavity corners (wall
// meets wall) stay sharp on purpose.
module box_corner_round_cutter(outer_l, outer_hb, outer_ht, outer_w, ih, wall, r) {
  nf = 64;
  // [cx, cy, sx, sy, z0]: corner point, material-side signs, z start
  for (
    c = [
      [-outer_l / 2, -outer_hb / 2, 1, 1, -1],
      [outer_l / 2, -outer_hb / 2, -1, 1, -1],
      [-outer_l / 2, -outer_hb / 2 + outer_ht, 1, -1, -1],
      [outer_l / 2, -outer_hb / 2 + outer_ht, -1, -1, -1],
      [0, ih / 2, -1, 1, wall],
    ]
  ) {
    x0 = c[2] < 0 ? c[0] - r : c[0];
    y0 = c[3] < 0 ? c[1] - r : c[1];
    hh = outer_w + 1 - c[4];
    difference() {
      translate([x0, y0, c[4]])
        cube([r, r, hh]);
      translate([c[0] + c[2] * r, c[1] + c[3] * r, c[4]])
        cylinder(r = r, h = hh, $fn = nf);
    }
  }
}

// ---- Box: label on the pocket floor (covered when insert is in) -------------
// States nominal dims; height reads inner_h/inner_h+opt_h because the L
// opening is inner_h over one half, inner_h + opt_h over the optic half.
// Two lines (title + dims), line centers spaced label_lh x dims-line
// size apart; title on top = +y side.
module floor_label_module(il, ih, opt_h, pocket_l, wall, label_depth, label_lh,
                          label_rot, floor_label_size, floor_title_size,
                          floor_title, floor_dims) {
  cy = ih / 2 + opt_h / 2; // pocket center y
  lh = floor_label_size * label_lh;
  // title line (larger, reads first)
  translate([pocket_l / 2, cy + lh / 2, wall - label_depth])
    rotate([0, 0, label_rot])
      label_svg(floor_title, floor_title_size, label_depth);
  // dimensions line (nominal values, incl. the optic height)
  translate([pocket_l / 2, cy - lh / 2, wall - label_depth])
    rotate([0, 0, label_rot])
      label_svg(floor_dims, floor_label_size, label_depth);
}

// ---- Box: CMA logo on the plaque (left of the pocket), INVERTED relief ------
// assets/logo/cma_logo.svg was traced from assets/logo/CMA-logo.avif
// (beige-on-transparent two-tone logo -> alpha silhouette), with a
// PADDED canvas (20 px margin each side). The trace with the padding
// imports as the BACKGROUND region (canvas with the bars/letters as
// holes): cutting the import DIRECTLY recesses the design panel +
// margin and leaves the elements RAISED at surface height (inverted
// relief, distinct from the recessed letter text labels); the margin
// keeps every element clear of the recess border. logo_w is the
// ELEMENT width in mm; the pad scales along.
module logo_module(outer_l, ih, opt_h, wall, outer_w, logo_w, logo_depth,
                   logo_svg) {
  aw = 645 * SVG_MM; // padded canvas (SVG units 645x149)
  ah = 149 * SVG_MM;
  f = logo_w / (605 * SVG_MM); // logo_w = ELEMENT width; pad scales along
  translate(
    [
      -outer_l / 4,
      ih / 2 + (opt_h + wall) / 2,
      outer_w - logo_depth,
    ]
  )
    scale([f, f, 1])
      translate([-aw / 2, -ah / 2, 0])
        linear_extrude(logo_depth + 0.1)
          import(logo_svg, center = false);
}

// ---- Box: the convertible gauge box -----------------------------------------
// Nominal inner dims + fit/wall in, finished part out (see header).
module cma_box(inner_l, inner_h, inner_w, opt_h, fit, wall,
               outer_r, inner_r, corner_r,
               floor_title, floor_dims,
               logo_w = 90, logo_depth = 0.8,
               floor_label = true, floor_label_size = 3.6,
               floor_title_size = 6.5, label_depth = 0.8,
               label_lh = 2.0, label_rot = 0,
               logo_svg = LOGO_SVG) {
  il = inner_l + fit; // (X, modeled)
  ih = inner_h + fit; // (Y, non-optic half)
  iw = inner_w + fit; // (Z)
  pocket_l = il / 2; // half length
  inner_ht = ih + opt_h; // (Y, optic half)
  outer_l = il + 2 * wall;
  outer_hb = ih + 2 * wall;
  outer_ht = inner_ht + 2 * wall;
  outer_w = iw + wall;
  o_c = min(outer_r, wall / 2);
  i_c = max(0, min(inner_r, wall - o_c));
  difference() {
    outer_shell(outer_l, outer_hb, outer_ht, outer_w);
    if (o_c > 0)
      outer_fillet_cutter(outer_l, outer_hb, outer_ht, outer_w, o_c);
    cavity(il, ih, iw, opt_h, pocket_l, wall);
    if (i_c > 0)
      fillet_cutter(il, ih, opt_h, pocket_l, outer_w, i_c);
    if (corner_r > 0)
      box_corner_round_cutter(outer_l, outer_hb, outer_ht, outer_w, ih, wall,
                              corner_r);
    if (logo_w > 0)
      logo_module(outer_l, ih, opt_h, wall, outer_w, logo_w, logo_depth,
                  logo_svg);
    if (floor_label)
      floor_label_module(il, ih, opt_h, pocket_l, wall, label_depth, label_lh,
                         label_rot, floor_label_size, floor_title_size,
                         floor_title, floor_dims);
  }
  echo(str("Footprint (L x H): ", outer_l, " x ", outer_ht, " mm, wall height (W): ", outer_w, " mm"));
  echo(str("Nominal inner (L x H x W): ", inner_l, " x ", inner_h, " x ", inner_w, " mm (+ fit ", fit, " = ", il, " x ", ih, " x ", iw, " mm modeled)"));
  echo(str("Nominal optic height: ", inner_h + opt_h, " mm over half length (modeled ", inner_ht, "); pocket ", pocket_l, " x ", opt_h, " x ", iw, " mm"));
  echo(str("Rim fillets: outer ", o_c, " mm, inner ", i_c, " mm (flat top annulus ", wall - o_c - i_c, " mm)"));
  echo(str("Convex vertical corner rounds: r ", corner_r, " mm (4 outer + L inner corner)"));
  echo(str("Floor label: ", floor_label ? "on" : "off", " (SVG), size ", floor_label_size, " mm, depth ", label_depth, " mm"));
}

// ---- Insert: convex vertical corner rounding --------------------------------
// TRUE tangent round on each of the 4 convex outer corners: cutter =
// corner block (r x r on the material side, full height) MINUS a
// cylinder of radius r centered INSIDE the material at (r, r) from the
// corner - leaves a smooth quarter cylinder tangent to both faces (not
// the cuspy "quarter circle" of a cylinder centered on the corner
// vertex).
module insert_corner_round_cutter(body_l, body_h, body_d, r) {
  nf = 64;
  for (c = [[0, 0, 1, 1], [body_l, 0, -1, 1],
            [0, body_h, 1, -1], [body_l, body_h, -1, -1]]) {
    x0 = c[2] < 0 ? c[0] - r : c[0];
    y0 = c[3] < 0 ? c[1] - r : c[1];
    difference() {
      translate([x0, y0, -1])
        cube([r, r, body_d + 2]);
      translate([c[0] + c[2] * r, c[1] + c[3] * r, -1])
        cylinder(r = r, h = body_d + 2, $fn = nf);
    }
  }
}

// ---- Insert: top-edge fillet (around the top face, radius r) ----------------
// Rounds the 4 horizontal edges of the top face. Per edge: band slab on
// the material side (r wide, from top-r to top) MINUS the fillet
// cylinder (axis along the edge, center at (face -/+ r, top - r)) -
// same pattern as the box rim fillets, tangent to the face and to the
// top plane.
module insert_top_fillet_cutter(body_l, body_h, body_d, r) {
  nf = 64;
  L = 400;
  ez = body_d - r;
  // edges along X: y = 0 (material +y) and y = body_h (material -y)
  for (e = [[0, 1], [body_h, -1]]) {
    y_e = e[0];
    s = e[1];
    ylo = s == 1 ? y_e : y_e - r;
    difference() {
      translate([-L, ylo, ez])
        cube([2 * L, r, r]);
      translate([0, y_e + s * r, ez])
        rotate([0, 90, 0])
          cylinder(r = r, h = 2 * L, center = true, $fn = nf);
    }
  }
  // edges along Y: x = 0 (material +x) and x = body_l (material -x)
  for (e = [[0, 1], [body_l, -1]]) {
    x_e = e[0];
    s = e[1];
    xlo = s == 1 ? x_e : x_e - r;
    difference() {
      translate([xlo, -L, ez])
        cube([r, 2 * L, r]);
      translate([x_e + s * r, 0, ez])
        rotate([90, 0, 0])
          cylinder(r = r, h = 2 * L, center = true, $fn = nf);
    }
  }
}

// ---- Insert: label on the top face ------------------------------------------
// States the NOMINAL gauge dims of the box with the insert in. Two
// lines (title + dims), line centers spaced label_lh x dims-line size
// apart; title on top = +y side.
module insert_label_module(body_l, body_h, body_d, title_label, dims_label,
                           label_size, label_title_size, label_depth, label_lh,
                           label_rot) {
  lh = label_size * label_lh;
  // title line (larger, reads first)
  translate([body_l / 2, body_h / 2 + lh / 2, body_d - label_depth])
    rotate([0, 0, label_rot])
      label_svg(title_label, label_title_size, label_depth);
  // dimensions line
  translate([body_l / 2, body_h / 2 - lh / 2, body_d - label_depth])
    rotate([0, 0, label_rot])
      label_svg(dims_label, label_size, label_depth);
}

// ---- Insert: the filler block ------------------------------------------------
// Derived from the box's NOMINAL parameters (keep them matched with the
// matching cma_box entry file): plan = pocket minus drop-in clearance,
// depth = nominal inner_w (flush with the rim - see header, INSERT FIT).
module cma_box_insert(inner_l, inner_w, opt_h, fit,
                      title_label, dims_label,
                      corner_r = 2.0, top_fillet_r = 1.0,
                      label_size = 4.0, label_title_size = 8.0,
                      label_depth = 0.8, label_lh = 2.0, label_rot = 0) {
  // pocket length minus drop-in clearance
  body_l = (inner_l + fit) / 2 - fit;
  // pocket height minus drop-in clearance
  body_h = opt_h - fit;
  // NOMINAL depth: the printed pocket is ~fit short, so this sits flush
  body_d = inner_w;
  difference() {
    // body: pocket fill minus the plan clearance
    cube([body_l, body_h, body_d]);
    if (corner_r > 0)
      insert_corner_round_cutter(body_l, body_h, body_d, corner_r);
    if (top_fillet_r > 0)
      insert_top_fillet_cutter(body_l, body_h, body_d, top_fillet_r);
    insert_label_module(body_l, body_h, body_d, title_label, dims_label,
                        label_size, label_title_size, label_depth, label_lh,
                        label_rot);
  }
  echo(str("Insert body: ", body_l, " x ", body_h, " x ", body_d, " mm (print height ", body_d, " mm, footprint ", body_l, " x ", body_h, " mm)"));
  echo(str("Corner rounds: r ", corner_r, " mm on the 4 outer corners; top-edge fillet r ", top_fillet_r, " mm"));
  echo(str("Label: \"", label_entry(title_label)[1], "\" / \"", label_entry(dims_label)[1], "\" ", label_size, " mm, depth ", label_depth, " mm"));
}
