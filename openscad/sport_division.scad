// ============================================================================
// CMA - The Box : Sport Division - CONVERTIBLE (Optics/Non-Optics)
// https://github.com/wwb-ag/cma-box
//
// Sport set of the convertible gauge box - same shapes as the Duty
// set, only the dimensions change. ALL geometry lives in
// cma_box_lib.scad - this file only sets the parameters and the label
// set, then calls cma_box().
//
//   - Sport Division        : gear fits 225 x 155 x 45 (insert installed)
//   - Sport Optics Division : gear fits 225 x 185 x 45, but the 185 mm
//     height is only needed over HALF the length (the optic sits on one
//     half of the slide). The cavity is an L: base 225 x 155 x 45 plus
//     a fixed extra pocket 112.5 x 30 x 45 (30 = 185 - 155) in the TOP
//     RIGHT corner of the plan view. The OUTER shape is a regular
//     rectangle (231.8 x 191.8 x 48.6): the area left of the pocket is
//     solid fill - a flat plaque flush with the rim, carrying the CMA
//     logo (inverted relief). The INSERT (sport_division_insert.scad)
//     fills the pocket, restoring the plain 225 x 155 x 45 version.
//
// LABELS (self-describing gauge):
//   - The insert carries "SPORT DIVISION / Length: 225 Height: 155
//     Width: 45" on its top face -> with the insert in, the reading
//     matches the opening.
//   - The pocket floor (the area covered by the insert) carries
//     "SPORT OPTIC DIVISION / Length: 225 Height: 155/185 Width: 45"
//     -> with the insert lifted out, the reading matches the L-shaped
//     opening (155 over one half, 185 over the other).
//
// PRINT BED: the footprint 231.8 x 191.8 mm does NOT fit a 220 x 220
// bed (see README, Printing Notes).
//
// Changing inner_l / inner_h / inner_w / opt_h here? Update
// sport_division_insert.scad to the same values.
// ============================================================================

include <cma_box_lib.scad>

/* [Parameters] */
// Wall thickness [mm] (multiple of 0.4 nozzle line width)
wall = 3.2; // [1:0.1:10]
// Printer clearance [mm]: one 0.4 mm nozzle width added to every
// NOMINAL inner dimension (printed cavities run up to a nozzle
// width undersized). Labels always print the nominal values.
fit = 0.4; // [0:0.05:1]
// Nominal inner length [mm] (firearm length)
inner_l = 225; // [10:1:400]
// Nominal inner height, non-optic half [mm]
inner_h = 155; // [10:1:400]
// Nominal inner width [mm] (firearm thickness = vertical wall height)
inner_w = 45; // [10:1:200]
// Extra height of the optic half [mm] (185 = inner_h + opt_h);
// NOT clearanced - it is a delta, the fit rides on inner_h
opt_h = 30; // [0:1:60]
// Fillet radius on the OUTER top rim edge [mm] (0 = sharp)
outer_r = 1.0; // [0:0.1:2]
// Fillet radius on the INNER top rim edge [mm]
// (double the outer; clamped so outer + inner <= wall)
inner_r = 2.0; // [0:0.1:3]
// Vertical corner radius [mm] (0 = sharp). Rounds the CONVEX
// vertical edges (4 outer + the L's inner corner): sharp convex
// corners deposit extra material in FDM and bulge slightly
corner_r = 2.0; // [0:0.5:4]
// CMA logo on the plaque (top-left): INVERTED relief - recessed
// design panel with the bars/letters raised (elements keep their
// current size; logo_w = element width in mm, 0 = no logo)
logo_w = 90; // [0:1:110]
// Logo recess depth [mm]
logo_depth = 0.8; // [0.4:0.1:2]
// Engraved label on the POCKET FLOOR (visible when the insert is
// removed) - on/off only. The wording lives in
// assets/font/label_svgs/ (generated by
// assets/font/create_label_svgs.py), not in this file.
floor_label = true; // [true,false]
// Floor label sizes [mm] - the pocket band is only 30 mm deep
// (112.7 mm long), keep the lines small enough to fit it.
floor_label_size = 3.6; // [3:0.5:20]
floor_title_size = 6.5; // [3:0.5:20]  (title line)
// Label engrave depth [mm]
label_depth = 0.8; // [0.4:0.1:2]
// Line spacing: center-to-center distance = label_lh x dims-line size
label_lh = 2.0; // [1:0.1:3]
// Label rotation [deg] (0 = reads with +y up)
label_rot = 0; // [0:15:359]

cma_box(
    inner_l = inner_l, inner_h = inner_h, inner_w = inner_w,
    opt_h = opt_h, fit = fit, wall = wall,
    outer_r = outer_r, inner_r = inner_r, corner_r = corner_r,
    floor_title = "sport/floor_title", floor_dims = "sport/floor_dims",
    logo_w = logo_w, logo_depth = logo_depth,
    floor_label = floor_label,
    floor_label_size = floor_label_size, floor_title_size = floor_title_size,
    label_depth = label_depth, label_lh = label_lh, label_rot = label_rot
);
